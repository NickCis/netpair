#!/usr/bin/make -f

export GO111MODULE=on
export CGO_ENABLED=0
export PATH := /usr/lib/go-1.26/bin:$(PATH)

%:
	dh $@

override_dh_auto_build:
	go build -trimpath -ldflags="-s -w" -o netpair ./cmd/netpair
	go build -trimpath -ldflags="-s -w" -o netpair-manager ./cmd/netpair-manager

override_dh_auto_test:
	go test ./...

override_dh_auto_install:
	install -D -m 755 netpair debian/netpair/usr/bin/netpair
	install -D -m 755 netpair-manager debian/netpair/usr/bin/netpair-manager
	install -D -m 644 README.md debian/netpair/usr/share/doc/netpair/README.md
	install -D -m 644 package/ubuntu/apparmor/usr.bin.pasta debian/netpair/etc/apparmor.d/usr.bin.pasta
	install -D -m 644 package/ubuntu/apparmor/usr.bin.netpair-manager debian/netpair/etc/apparmor.d/usr.bin.netpair-manager

override_dh_dwz:
	:

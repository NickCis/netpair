# Maintainer: Nicolas Cisco <nicolas@nckweb.com.ar>
# The source is the git tag v${pkgver}; tag and push it before publishing
# (see AGENTS.md and package/aur/README.md).
pkgname=netpair
pkgver=0.1.6
pkgrel=1
pkgdesc="Run process pairs in isolated network namespaces with port relay and SSH forwarding"
arch=('x86_64' 'aarch64')
url="https://github.com/NickCis/netpair"
license=('MIT')
depends=('passt')
makedepends=('go')
optdepends=(
  'iproute2: port auto-discovery in netpair connect'
)
source=("${pkgname}::git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
  cd "${pkgname}"
  export CGO_ENABLED=0
  go build -trimpath -ldflags="-s -w" -o netpair ./cmd/netpair
  go build -trimpath -ldflags="-s -w" -o netpair-manager ./cmd/netpair-manager
}

check() {
  cd "${pkgname}"
  go test ./...
}

package() {
  cd "${pkgname}"
  install -Dm755 netpair "$pkgdir/usr/bin/netpair"
  install -Dm755 netpair-manager "$pkgdir/usr/bin/netpair-manager"
  install -Dm644 README.md "$pkgdir/usr/share/doc/netpair/README.md"
}
